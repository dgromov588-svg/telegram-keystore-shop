# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram-token
# Optional secret that Telegram sends as X-Telegram-Bot-Api-Secret-Token for webhook requests.
TELEGRAM_WEBHOOK_SECRET=change-me
# Public webhook URL, for example: https://example.com/chatgpt-bot/public/index.php
APP_URL=https://example.com/chatgpt-bot/public/index.php

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.2
OPENAI_INSTRUCTIONS=Ты ChatGPT в Telegram. Отвечай на русском языке понятно, полезно и дружелюбно. Если вопрос опасный или незаконный — откажись и предложи безопасную альтернативу.
OPENAI_MAX_OUTPUT_TOKENS=1200

# Local JSON storage for conversation response IDs.
CONVERSATION_STORE=storage/conversations.json
